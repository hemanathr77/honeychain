# HoneyChain Server — Environment Variables
# ============================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER commit .env to git — only this example file is safe
# ============================================================

# ── PostgreSQL Database ──────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=honeychain
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
# Set DATABASE_SSL=true for Neon, Railway, or any cloud PostgreSQL

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://your-app.vercel.app

# ── Admin Account ────────────────────────────────────────────
# Created automatically on first server start if no admin exists
# CHANGE THE PASSWORD IMMEDIATELY after first login
ADMIN_EMAIL=admin@honeychain.local
ADMIN_PASSWORD=

# ── Blockchain (Hardhat localhost for development) ────────────
# After: npx hardhat node  +  npx hardhat run scripts/deploy.js --network localhost
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# NEVER commit a real private key — use a test key for local dev only
BLOCKCHAIN_PRIVATE_KEY=
HONEYCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337
# For testnet explorer links e.g. https://sepolia.etherscan.io/tx/
BLOCKCHAIN_EXPLORER_URL=

# ── File Uploads ─────────────────────────────────────────────
# Leave empty to use default ./uploads directory
UPLOAD_DIR=
