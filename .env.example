# HoneyChain Frontend — Environment Variables
# ============================================================
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# .env.local is gitignored by default — safe for local secrets
# ============================================================

# ── API Base URL ─────────────────────────────────────────────
# Local development (default — no need to set if using localhost)
VITE_API_URL=http://localhost:5000/api

# Production (Vercel): set this in Vercel dashboard → Project Settings → Environment Variables
# VITE_API_URL=https://your-backend.onrender.com/api
